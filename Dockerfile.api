# Dockerfile.api - API service
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV LANG=C.UTF-8

# Install system deps needed for psycopg2 and building wheels (small and safe)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libpq-dev curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install (use linux-friendly versions)
COPY requirements.txt /app/requirements.txt

RUN pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r /app/requirements.txt

# Copy all project files
COPY . /app

# Ensure both /app and /app/src are in PYTHONPATH so imports work either way
ENV PYTHONPATH="/app:/app/src:${PYTHONPATH}"

# Symlink to ensure 'models' import path works when running from src
RUN mkdir -p /app/src && ln -sfn /app/models /app/src/models_link

EXPOSE 8000

# Healthcheck: check docs page is present
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://localhost:8000/ || exit 1

# Use non-root uvicorn process command
CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
